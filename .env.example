# Comma-separated list of extra frontend origins to allow via CORS, on top of the
# defaults already built in (localhost:3000, localhost:5173, 127.0.0.1:5173).
# Example: ALLOWED_ORIGINS=https://your-deployed-frontend.com
ALLOWED_ORIGINS=

# Whitelists the 5 synthetic demo ID numbers past the Luhn checksum (they don't
# all pass it for real). Keep "true" for the hackathon demo; set "false" to
# enforce strict validation on every ID.
ALLOW_DEMO_IDS=true

# Groq API key for the "Home Affairs, Explained" chatbot's classification and
# phrasing calls (backend/services/home_affairs_guide.py). Falls back to the
# deterministic keyword classifier/templated phrasing if unset.
GROQ_API_KEY=
